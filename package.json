{
  "name": "task-management-node-js",
  "version": "0.0.1",
  "description": "Task management",
  "main": "app.ts",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx esbuild.ts",
    "dev:prod": "cross-env NODE_ENV=production npm run dev",
    "start": "cross-env NODE_ENV=production npm run build && fastify start dist/app.js --host 0.0.0.0",
    "start:dev": "cross-env NODE_ENV=development npm run build:dev && fastify start dist/app.js --host 0.0.0.0",
    "build": "rm -rf dist && cross-env NODE_ENV=production tsx esbuild.ts",
    "build:dev": "rm -rf dist && cross-env NODE_ENV=development tsx esbuild.ts",
    "migrate": "npx knex migrate:latest --esm --knexfile ./src/database/knexfile.ts",
    "migrate:prod": "cross-env NODE_ENV=production npx knex migrate:latest --esm --knexfile ./src/database/knexfile.ts",
    "migrate:make": "npx knex migrate:make --knexfile ./src/database/knexfile.ts --esm",
    "seed": "npx knex seed:run --knexfile ./src/database/knexfile.ts --esm --specific",
    "seed:file": "npx knex seed:run --knexfile ./src/database/knexfile.ts --esm --specific",
    "seed:prod:file": "cross-env NODE_ENV=production npx knex seed:run --knexfile ./src/database/knexfile.ts --esm",
    "seed:prod": "cross-env NODE_ENV=production npx knex seed:run --knexfile ./src/database/knexfile.ts --esm",
    "seed:make": "npx knex seed:make --knexfile ./src/database/knexfile.ts --esm",
    "delete:db": "cross-env NODE_ENV=development node ./src/database/deleteDatabase.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache . --ext .js,.ts",
    "lint:fix": "eslint --cache . --ext .js,.ts --fix",
    "prepare": "husky",
    "commit": "git add . && lint-staged && czg",
    "push": "git add . && lint-staged && git add . && czg && git push origin",
    "format": "prettier --write .",
    "create": "plop"
  },
  "lint-staged": {
    "*.{ts,js,jsx,tsx}": [
      "eslint --cache --fix",
      "prettier --ignore-path .gitignore --write"
    ]
  },
  "dependencies": {
    "@fastify/autoload": "^6.2.0",
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/http-proxy": "^11.1.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.3.0",
    "fastify-plugin": "^5.0.1",
    "firebase": "^11.6.0",
    "fluent-json-schema": "^5.0.0",
    "husky": "^9.1.7",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "node-cron": "^3.0.3",
    "objection": "^3.1.5",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/async": "^3.2.24",
    "@types/bcryptjs": "^3.0.0",
    "@types/dotenv": "^8.2.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "czg": "^1.11.1",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.2",
    "esbuild-plugin-tsc": "^0.5.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-perfectionist": "^4.11.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.2",
    "eslint-plugin-unicorn": "^58.0.0",
    "fastify-cli": "^7.4.0",
    "fastify-tsconfig": "^3.0.0",
    "globals": "^16.0.0",
    "inquirer-autocomplete-prompt": "^3.0.1",
    "lint-staged": "^15.5.0",
    "pino-pretty": "^13.0.0",
    "plop": "^4.0.1",
    "prettier": "^3.5.3",
    "tiny-glob": "^0.2.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0"
  },
  "keywords": [
    "knex"
  ],
  "author": "hariharan",
  "license": "ISC"
}
